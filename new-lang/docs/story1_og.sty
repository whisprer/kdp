// kernels assume analog inputs in [0,1], but we carry continuous values
double analog_nand(double a, double b) { return 1.0 - a*b; }
double analog_nor (double a, double b) { return 1.0 - std::max(a,b); }

// second-order gate: integrate base gate over neighborhood with kernel K
double G2_accum(const Field& X, int i, int j,
                bool use_nor, double tau,
                const Kernel& K) {
    double s = 0.0, w = 0.0;
    for (auto [di,dj,kw] : K.lobes) {
        double a = X(i, j);
        double b = X(i+di, j+dj);
        double g = use_nor ? analog_nor(a,b) : analog_nand(a,b);
        s += kw * g; w += kw;
    }
    double A = s / w;            // analog truth accumulation
    return (A - tau);            // signed distance to threshold
}

bool G2_decision(const Field& X, int i, int j,
                 bool use_nor, double tau, const Kernel& K) {
    return G2_accum(X,i,j,use_nor,tau,K) >= 0.0;
}

